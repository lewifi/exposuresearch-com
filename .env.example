# Master Environment Configuration (Root)

# Split Google AI Studio API Keys (Tier 2 Billing)
# You can provide individual keys per workload, or use the fallback key for all.
VITE_GEMINI_API_KEY=your_general_fallback_key_here
VITE_GEMINI_VISION_API_KEY=your_vision_key_here
VITE_GEMINI_TTS_API_KEY=your_tts_key_here

# Backend / Worker Key Bindings (if needed)
GEMINI_API_KEY=your_general_fallback_key_here
GEMINI_VISION_API_KEY=your_vision_key_here
GEMINI_TTS_API_KEY=your_tts_key_here

# Active Gemini 3.1 Models
VITE_GEMINI_VISION_MODEL=gemini-3.1-flash-lite
VITE_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Default Narrator Voice (Options: Kore, Puck, Fenrir, Aoede, Charon)
VITE_GEMINI_VOICE_NAME=Kore
GEMINI_VOICE_NAME=Kore
