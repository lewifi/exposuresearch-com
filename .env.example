# Master Unified Environment Configuration (Root)
# Used interchangeably by both Vite (Frontend) and Cloudflare (Backend)

# Split Google AI Studio API Keys (Tier 2 Billing)
GEMINI_API_KEY=your_general_fallback_key_here
GEMINI_VISION_API_KEY=your_vision_key_here
GEMINI_TTS_API_KEY=your_tts_key_here

# Active Gemini 3.1 Models
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Default Narrator Voice (Options: Kore, Puck, Fenrir, Aoede, Charon)
GEMINI_VOICE_NAME=Kore
